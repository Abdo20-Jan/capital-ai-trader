# ===== Corretora =====
# paper        = simulador offline (preços e notícias sintéticas, não precisa de conta)
# capital_demo = conta DEMO da Capital.com (preços reais, ordens reais na demo)
BROKER=paper

# Capital.com > Configurações > API integrations > Generate new key (exige 2FA ativo)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=seu-email-de-login@exemplo.com
# Senha personalizada definida ao criar a chave de API
CAPITAL_PASSWORD=

# ===== IA (opcional) =====
# Sem chave, o bot usa um analisador de sentimento por dicionário (gratuito).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===== Estratégia =====
# EPIC da Capital.com, opcionalmente com o ticker usado nas notícias: EPIC:TICKER
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA
RESOLUTION=MINUTE_15
LOOP_SECONDS=60

# ===== Meta e risco =====
START_BALANCE=60
TARGET_BALANCE=100
RISK_PER_TRADE=0.02
MAX_RISK_PER_TRADE=0.05
MAX_DAILY_LOSS=0.06
MAX_OPEN_POSITIONS=2
MAX_MARGIN_USAGE=0.5
# Alavancagem máxima da sua conta (ex.: 200 = 1:200). Na conta demo, a margem de cada
# ativo vem da própria Capital.com; este valor só é usado no simulador.
MAX_LEVERAGE=200
# Teto de EXPOSIÇÃO: valor total das posições ≤ MAX_EXPOSURE × patrimônio.
# Ex.: 30 → com $60 o bot nunca controla mais que $1.800, mesmo podendo 1:200 ($12.000).
MAX_EXPOSURE=30
STOP_ATR=1.5
TAKE_PROFIT_ATR=2.25
# Probabilidade mínima (do modelo ML) de o alvo ser atingido antes do stop.
# Com alvo 2.25 ATR e stop 1.5 ATR, o empate (sem custos) é 40%.
PROB_THRESHOLD=0.50
# Quanto o sentimento das notícias (-1..+1) desloca essa probabilidade.
SENTIMENT_WEIGHT=0.10

DB_PATH=data/trader.db
